---
source: crates/guildsmith-core/tests/template.rs
expression: text
---
#:schema https://raw.githubusercontent.com/clarkscode/guildsmith/main/schema/guild.schema.json
# Imported by guildsmith 0.0.0-test from the template "Local Community" (cEmkU8yWhZpU) on 2026-10-20.
# Template ids are placeholders, so this file has none: items are matched by name when it is
# planned. guildsmith never creates servers (bots can't); plan this against a server you made.

[guild]
name = "Local Community"  # informational

# Roles are listed highest first.
[[roles]]
name = "Admins"
color = "#E74C3C"
hoist = true
mentionable = false
permissions = ["administrator"]

[[roles]]
name = "Organizers"
color = "#9B59B6"
hoist = true
mentionable = true
permissions = ["manage_events"]

[[roles]]
name = "Neighbors"
color = "#2ECC71"
hoist = false
mentionable = false
permissions = []

[[roles]]
name = "@everyone"
permissions = ["add_reactions", "attach_files", "change_nickname", "connect", "create_instant_invite", "embed_links", "mention_everyone", "read_message_history", "request_to_speak", "send_messages", "send_tts_messages", "speak", "stream", "use_application_commands", "use_external_emojis", "use_vad", "view_channel"]

[[categories]]
name = "Chat"
overwrites = []

  [[categories.channels]]
  name = "general"
  kind = "text"
  nsfw = false
  slowmode = 0
  sync_permissions = true

  [[categories.channels]]
  name = "buy-sell-trade"
  kind = "text"
  topic = "Local listings only"
  nsfw = false
  slowmode = 60
  sync_permissions = true

[[categories]]
name = "Events"
overwrites = [
  { target = "@everyone", deny = ["view_channel"] },
  { target = "@Neighbors", allow = ["view_channel"] },
]

  [[categories.channels]]
  name = "event-planning"
  kind = "text"
  nsfw = false
  slowmode = 0
  sync_permissions = true

  [[categories.channels]]
  name = "Town Hall"
  kind = "stage"
  nsfw = false
  bitrate = 64000
  user_limit = 0
  rtc_region = "auto"
  sync_permissions = true

[[channels]]
name = "announcements"
kind = "announcement"
topic = "News from the organizers"
nsfw = false
overwrites = [
  { target = "@everyone", deny = ["send_messages"] },
  { target = "@Organizers", allow = ["send_messages"] },
]

# unmanaged: "directory" (channel type 14)

[prune]
roles = false
categories = false
channels = false
