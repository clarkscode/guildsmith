---
source: crates/guildsmith-core/tests/template.rs
expression: text
---
#:schema https://raw.githubusercontent.com/clarkscode/guildsmith/main/schema/guild.schema.json
# Imported by guildsmith 0.0.0-test from the template "Study Group" (2TfF7a6xQFwT) on 2026-10-20.
# Template ids are placeholders, so this file has none: items are matched by name when it is
# planned. guildsmith never creates servers (bots can't); plan this against a server you made.

[guild]
name = "Study Group"  # informational

# Roles are listed highest first.
[[roles]]
name = "Tutors"
color = "#1ABC9C"
hoist = true
mentionable = true
permissions = ["manage_messages"]

[[roles]]
name = "@everyone"
permissions = ["add_reactions", "attach_files", "change_nickname", "connect", "create_instant_invite", "embed_links", "mention_everyone", "read_message_history", "request_to_speak", "send_messages", "send_tts_messages", "speak", "stream", "use_application_commands", "use_external_emojis", "use_vad", "view_channel"]

[[categories]]
name = "Information"
overwrites = [
  { target = "@everyone", allow = ["view_channel"], deny = ["send_messages"] },
]

  [[categories.channels]]
  name = "welcome-and-rules"
  kind = "text"
  topic = "Read me first"
  nsfw = false
  slowmode = 0
  sync_permissions = true

  [[categories.channels]]
  name = "notes-resources"
  kind = "text"
  nsfw = false
  slowmode = 0
  sync_permissions = true

[[categories]]
name = "Study"
overwrites = []

  [[categories.channels]]
  name = "homework-help"
  kind = "text"
  nsfw = false
  slowmode = 0
  sync_permissions = true

  [[categories.channels]]
  name = "questions"
  kind = "forum"
  topic = "Ask one question per post"
  nsfw = false
  slowmode = 0
  tags = [{ name = "math", emoji = "🧮", moderated = false }, { name = "answered", emoji = "✅", moderated = true }]
  default_reaction = "👍"
  sync_permissions = true

  [[categories.channels]]
  name = "Study Room 1"
  kind = "voice"
  nsfw = false
  bitrate = 64000
  user_limit = 10
  rtc_region = "auto"
  sync_permissions = true

[[channels]]
name = "Lounge"
kind = "voice"
nsfw = false
bitrate = 64000
user_limit = 0
rtc_region = "auto"
overwrites = []

[prune]
roles = false
categories = false
channels = false
